{
  "rules": {
    "queue": {
      "$date": {
        "$servicePoint": {
          ".read": "auth != null",
          "$ticketId": {
            ".write": "auth != null && (!data.exists() || data.child('patientId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'nurse')"
          }
        }
      }
    },
    "queueMeta": {
      "$date": {
        "$servicePoint": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
