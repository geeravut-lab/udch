rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function tokenRole() {
      return signedIn() && 'role' in request.auth.token
        ? request.auth.token.role
        : null;
    }

    function isAdmin() {
      return tokenRole() == 'admin';
    }

    function isStaff() {
      return tokenRole() in ['nurse', 'doctor', 'admin'];
    }

    function isOwner(userId) {
      return signedIn() && uid() == userId;
    }

    function isCaregiverOf(patientId) {
      return signedIn()
        && exists(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + uid()))
        && get(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + uid())).data.status == 'active'
        && get(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + uid())).data.caregiverId == uid();
    }

    function caregiverCanSeeResults(patientId) {
      return isCaregiverOf(patientId)
        && get(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + uid())).data.permission
          in ['appointments_and_results', 'full'];
    }

    function isPatientOwner() {
      return signedIn() && resource.data.patientId == uid();
    }

    function createsAsPatient() {
      return signedIn() && request.resource.data.patientId == uid();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff() || isCaregiverOf(userId);
      allow create: if isOwner(userId);
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'hn']));
      allow delete: if isAdmin();
    }

    match /journeys/{journeyId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.patientId == uid())
        || isCaregiverOf(resource.data.patientId);
      allow create: if isStaff() || createsAsPatient();
      allow update: if isStaff()
        || (isPatientOwner() && request.resource.data.patientId == resource.data.patientId);
      allow delete: if isStaff() || isPatientOwner();

      match /steps/{stepId} {
        allow read: if isStaff()
          || get(/databases/$(database)/documents/journeys/$(journeyId)).data.patientId == uid()
          || isCaregiverOf(get(/databases/$(database)/documents/journeys/$(journeyId)).data.patientId);
        allow create, update, delete: if isStaff()
          || get(/databases/$(database)/documents/journeys/$(journeyId)).data.patientId == uid();
      }
    }

    match /appointments/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || isCaregiverOf(resource.data.patientId);
      allow create: if isStaff() || createsAsPatient();
      allow update: if isStaff()
        || (isPatientOwner() && request.resource.data.patientId == resource.data.patientId);
      allow delete: if isStaff() || isPatientOwner();
    }

    match /medicalResults/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || caregiverCanSeeResults(resource.data.patientId);
      allow create: if isStaff() || createsAsPatient();
      allow update: if isStaff()
        || (isPatientOwner() && request.resource.data.patientId == resource.data.patientId);
      allow delete: if isStaff() || isPatientOwner();
    }

    match /medications/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || isCaregiverOf(resource.data.patientId);
      allow create: if isStaff() || createsAsPatient();
      allow update: if isStaff()
        || (isPatientOwner() && request.resource.data.patientId == resource.data.patientId);
      allow delete: if isStaff() || isPatientOwner();
    }

    match /treatmentCycles/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || isCaregiverOf(resource.data.patientId);
      allow create: if isStaff() || createsAsPatient();
      allow update: if isStaff()
        || (isPatientOwner() && request.resource.data.patientId == resource.data.patientId);
      allow delete: if isStaff() || isPatientOwner();
    }

    match /conversations/{conversationId} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || (resource.data.participantIds is list && uid() in resource.data.participantIds);
      allow create: if isStaff() || createsAsPatient();
      allow update: if isStaff()
        || (isPatientOwner() && request.resource.data.patientId == resource.data.patientId);
      allow delete: if isStaff() || isPatientOwner();

      match /messages/{messageId} {
        allow read: if isStaff()
          || get(/databases/$(database)/documents/conversations/$(conversationId)).data.patientId == uid()
          || (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds is list
              && uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && (
            isStaff()
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.patientId == uid()
          );
        allow update, delete: if isStaff()
          || resource.data.senderId == uid()
          || get(/databases/$(database)/documents/conversations/$(conversationId)).data.patientId == uid();
      }
    }

    match /notifications/{id} {
      allow read: if isStaff() || resource.data.userId == uid();
      allow create: if isStaff()
        || (signedIn() && request.resource.data.userId == uid());
      allow update: if isStaff() || resource.data.userId == uid();
      allow delete: if isStaff() || resource.data.userId == uid();
    }

    match /documents/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || caregiverCanSeeResults(resource.data.patientId);
      allow create: if isStaff() || createsAsPatient();
      allow update: if isStaff()
        || (isPatientOwner() && request.resource.data.patientId == resource.data.patientId);
      allow delete: if isStaff() || isPatientOwner();
    }


    match /referrals/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || isCaregiverOf(resource.data.patientId);
      allow create: if isStaff() || createsAsPatient();
      allow update: if isStaff()
        || (isPatientOwner() && request.resource.data.patientId == resource.data.patientId);
      allow delete: if isStaff() || isPatientOwner();
    }


    match /eproEntries/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || isCaregiverOf(resource.data.patientId);
      allow create: if signedIn() && request.resource.data.patientId == uid();
      allow update, delete: if isStaff()
        || resource.data.patientId == uid();
    }

    match /teleSessions/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid();
      allow create: if signedIn() && request.resource.data.patientId == uid();
      allow update: if isStaff()
        || (resource.data.patientId == uid()
            && request.resource.data.patientId == resource.data.patientId);
      allow delete: if isStaff() || resource.data.patientId == uid();
    }

    match /payments/{id} {
      allow read: if isStaff() || resource.data.patientId == uid();
      allow create: if signedIn()
        && request.resource.data.patientId == uid()
        && request.resource.data.status in ['pending', 'awaiting_review'];
      allow update: if isStaff()
        || (
          resource.data.patientId == uid()
          && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.status in ['pending', 'awaiting_review', 'cancelled']
        );
      allow delete: if isStaff() || isAdmin();
    }

    match /caregiverLinks/{linkId} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || resource.data.caregiverId == uid()
        || (resource.data.status == 'pending'
            && resource.data.caregiverEmail == request.auth.token.email);
      allow create: if signedIn()
        && (request.resource.data.patientId == uid() || isAdmin());
      allow update: if isStaff()
        || resource.data.patientId == uid()
        || (resource.data.caregiverId == uid()
            && request.resource.data.status in ['active', 'revoked'])
        || (resource.data.status == 'pending'
            && request.resource.data.caregiverId == uid()
            && request.resource.data.status in ['active', 'revoked']
            && resource.data.caregiverEmail == request.auth.token.email);
      allow delete: if isAdmin() || resource.data.patientId == uid();
    }

    match /educationArticles/{id} {
      allow read: if resource.data.isPublished == true || isStaff();
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.isPublished == true);
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /aiEvents/{id} {
      allow read, write: if isAdmin();
    }

    match /auditLog/{id} {
      allow read: if isStaff();
      allow create: if signedIn();
    }
  }
}
