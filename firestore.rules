rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function tokenRole() {
      return signedIn() && 'role' in request.auth.token
        ? request.auth.token.role
        : null;
    }

    function isAdmin() {
      return tokenRole() == 'admin';
    }

    function isStaff() {
      return tokenRole() in ['nurse', 'doctor', 'admin'];
    }

    function isOwner(userId) {
      return signedIn() && uid() == userId;
    }

    // Caregiver active link to patient (permission optional filter)
    function caregiverLink(patientId) {
      return signedIn() && exists(
        /databases/$(database)/documents/caregiverLinks/$(uid() + '_' + patientId)
      ) && get(
        /databases/$(database)/documents/caregiverLinks/$(uid() + '_' + patientId)
      ).data.status == 'active'
        && get(
        /databases/$(database)/documents/caregiverLinks/$(uid() + '_' + patientId)
      ).data.caregiverId == uid();
    }

    // Fallback: query-style not available in rules; we also allow read if
    // any active link document lists this caregiver (id convention patient_caregiver)
    function isCaregiverOf(patientId) {
      return signedIn() && (
        caregiverLink(patientId)
        || (
          exists(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + uid()))
          && get(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + uid())).data.status == 'active'
          && get(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + uid())).data.caregiverId == uid()
        )
      );
    }

    function caregiverCanSeeResults(patientId) {
      return isCaregiverOf(patientId)
        && get(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + uid())).data.permission
          in ['appointments_and_results', 'full'];
    }

    // ----- users -----
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff() || isCaregiverOf(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      // role / hn changes: prefer Admin SDK only; if client update, block role escalation
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'hn']);
      allow delete: if isAdmin();
    }

    // ----- journeys -----
    match /journeys/{journeyId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.patientId == uid())
        || (signedIn() && isCaregiverOf(resource.data.patientId));
      allow write: if isStaff();

      match /steps/{stepId} {
        allow read: if isStaff()
          || get(/databases/$(database)/documents/journeys/$(journeyId)).data.patientId == uid()
          || isCaregiverOf(
               get(/databases/$(database)/documents/journeys/$(journeyId)).data.patientId
             );
        allow write: if isStaff();
      }
    }

    // ----- appointments -----
    match /appointments/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || isCaregiverOf(resource.data.patientId);
      allow create: if isStaff()
        || (signedIn() && request.resource.data.patientId == uid());
      allow update, delete: if isStaff()
        || (resource.data.patientId == uid()
            && request.resource.data.patientId == resource.data.patientId);
    }

    // ----- medicalResults -----
    match /medicalResults/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || caregiverCanSeeResults(resource.data.patientId);
      allow write: if isStaff();
    }

    // ----- medications / treatmentCycles -----
    match /medications/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || isCaregiverOf(resource.data.patientId);
      allow write: if isStaff();
    }

    match /treatmentCycles/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || isCaregiverOf(resource.data.patientId);
      allow write: if isStaff();
    }

    // ----- conversations / messages -----
    match /conversations/{conversationId} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || uid() in resource.data.participantIds;
      allow create: if signedIn()
        && (isStaff() || request.resource.data.patientId == uid());
      allow update: if isStaff()
        || resource.data.patientId == uid();

      match /messages/{messageId} {
        allow read: if isStaff()
          || get(/databases/$(database)/documents/conversations/$(conversationId)).data.patientId == uid()
          || uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn()
          && request.resource.data.senderId == uid();
        allow update: if signedIn()
          && (resource.data.senderId == uid() || isStaff());
      }
    }

    // ----- notifications -----
    match /notifications/{id} {
      allow read: if isStaff() || resource.data.userId == uid();
      allow create: if isStaff() || (signedIn() && request.resource.data.userId == uid());
      allow update: if resource.data.userId == uid() || isStaff();
    }

    // ----- documents -----
    match /documents/{id} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || caregiverCanSeeResults(resource.data.patientId);
      allow write: if isStaff();
    }

    // ----- payments (client must not mark as paid) -----
    match /payments/{id} {
      allow read: if isStaff() || resource.data.patientId == uid();
      allow create: if signedIn()
        && request.resource.data.patientId == uid()
        && request.resource.data.status in ['pending', 'awaiting_review'];
      allow update: if isStaff()
        || (
          resource.data.patientId == uid()
          && request.resource.data.status in ['pending', 'awaiting_review', 'cancelled']
          && request.resource.data.status != 'paid'
          && request.resource.data.patientId == resource.data.patientId
        );
    }

    // ----- caregiverLinks -----
    // Prefer document id = patientId_caregiverId for rules lookups
    match /caregiverLinks/{linkId} {
      allow read: if isStaff()
        || resource.data.patientId == uid()
        || resource.data.caregiverId == uid();
      allow create: if signedIn()
        && (request.resource.data.patientId == uid() || isAdmin());
      allow update: if isStaff()
        || resource.data.patientId == uid()
        || (resource.data.caregiverId == uid()
            && request.resource.data.status in ['active', 'revoked']);
      allow delete: if isAdmin() || resource.data.patientId == uid();
    }

    // ----- education -----
    match /educationArticles/{id} {
      allow read: if resource.data.isPublished == true || isStaff();
      allow write: if isAdmin();
    }

    // ----- settings -----
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ----- aiEvents / auditLog -----
    match /aiEvents/{id} {
      allow read, write: if isAdmin();
    }

    match /auditLog/{id} {
      allow read: if isStaff();
      allow create: if signedIn();
    }
  }
}
